---
#1659: an expected type flows from the other operand of `==`/`!=`, and a `let`
annotation decides an `Ok`/`Err` over the enclosing return type.
---
commons demo.inf

fn isNone(o: Option[Int]) -> Bool {
  o == None
}

fn isNoneFlipped(o: Option[Int]) -> Bool {
  None == o
}

fn isSeven(r: Result[Int, String]) -> Bool {
  r == Ok(7)
}

fn notBad(r: Result[Int, String]) -> Bool {
  r != Err("bad")
}

fn none() -> Option[Int] {
  None
}

fn seven() -> Result[Int, String] {
  Ok(7)
}
