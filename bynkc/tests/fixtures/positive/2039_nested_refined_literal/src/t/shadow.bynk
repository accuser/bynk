context t.shadow

consumes t.pay

-- #2039: a caller's own `Cents` does not decide admission; each nested
-- literal is checked against `t.pay`'s `Cents` and crosses as it.
type Cents = Int where InRange(1, 5000)

service optional {
	on call() -> Effect[Int] by c: Caller { t.pay.maybe(Some(250)) }
}

service listed {
	on call() -> Effect[Int] by c: Caller { t.pay.total([10, 20]) }
}

-- #2043: empty constructors take the callee's parameter types, so the
-- caller's own `Cents` plays no part.
service empties {
	on call() -> Effect[Int] by c: Caller { t.pay.many([], None, Map.empty()) }
}

service settled {
	on call() -> Effect[Int] by c: Caller { t.pay.settle(Ok(9)) }
}
