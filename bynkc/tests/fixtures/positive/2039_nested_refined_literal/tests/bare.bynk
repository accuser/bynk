-- #2039: nested literals from a caller with no `uses t.values`, run over
-- the wire.
suite t.bare as system {
	case "an Option payload from a caller with no uses" {
		let r <- t.bare.optional() by Caller("t.other")
		expect r == 250
	}

	case "list elements from a caller with no uses" {
		let r <- t.bare.listed() by Caller("t.other")
		expect r == 6
	}

	case "a Result payload from a caller with no uses" {
		let r <- t.bare.settled() by Caller("t.other")
		expect r == 7
	}

	case "empty constructors from a caller with no uses" {
		let r <- t.bare.empties() by Caller("t.other")
		expect r == 0
	}

	case "a record field from a caller with no uses" {
		let r <- t.bare.placed() by Caller("t.other")
		expect r == 40
	}
}
