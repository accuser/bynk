context shop.rates

-- #1863: a context consumed only for its capability, by `shop.fees`, whose
-- provider is `given` it. `shop.orders` never consumes this context itself,
-- so its test module imports it only because the deps factory names it.
exports capability { Rates }

capability Rates {
  fn rate() -> Effect[Int]
}

provides Rates = FixedRates {
  fn rate() -> Effect[Int] { 3 }
}
