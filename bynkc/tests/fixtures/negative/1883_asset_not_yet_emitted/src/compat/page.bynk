commons compat.page

-- #1883, slice 1a: a well-formed asset checks clean (`bynk check`, the
-- editor), but a build refuses it until slice 1b can emit it. Exact: the gate
-- is the only diagnostic, so everything else about the project is valid.

---
The board's stylesheet.
---
asset style = "assets/board.css"

fn link(a: Asset) -> String {
  a.url
}

fn sheet() -> String {
  link(style)
}
